# Copy to .env (gitignored) and fill in. Never commit real values.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Comma-separated list of allowed browser origins (frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- GoDaddy ----
# Selects which key/secret pair below is used: "ote" (sandbox) or "production".
GODADDY_ENV=ote
GODADDY_OTE_API_KEY=
GODADDY_OTE_API_SECRET=
GODADDY_PRODUCTION_API_KEY=
GODADDY_PRODUCTION_API_SECRET=

# ---- Safety data sources ----
# Two-wheeler routing. Defaults to the public fair-use demo server; self-host for real traffic.
# VALHALLA_URL=https://valhalla1.openstreetmap.de
# https://account.heigit.org (OpenRouteService, address search)
ORS_API_KEY=
# https://developer.tomtom.com (live traffic flow)
TOMTOM_API_KEY=
# https://opencellid.org (cell tower density, used by `npm run ingest`)
OPENCELLID_API_KEY=
# https://urs.earthdata.nasa.gov > Generate Token (night lights, used by `npm run ingest`)
NASA_EARTHDATA_TOKEN=

# ---- Contact form ----
# The site's mailbox; the form sends through it and delivers to it. Leave blank to hide the form.
# GoDaddy mailboxes: smtpout.secureserver.net, port 465, the full email address as the user.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
# The mailbox password, set in GoDaddy's email dashboard. Secret.
SMTP_PASSWORD=

# ---- Deploy ----
# GoDaddy Node.js Hosting app for `npm run deploy` (from `gddy hosting app create`). Not a secret.
GDDY_APP_ID=

# ---- Firebase ----
FIREBASE_PROJECT_ID=
# Public identifier (not a secret). Only the smoke test needs it, to sign in a throwaway user.
FIREBASE_WEB_API_KEY=
# Option A (local dev): leave credentials blank and run the Firebase emulators, set the hosts below.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Option B (real project): paste the service-account JSON as ONE line (or base64-encode it).
FIREBASE_SERVICE_ACCOUNT_JSON=
