# Copy to .env (gitignored) and fill in. Never commit real values.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Comma-separated list of allowed browser origins (frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- GoDaddy ----
# "ote" = GoDaddy's test sandbox (safe, no real charges). Use "production" only deliberately.
GODADDY_ENV=ote
# Personal Access Token from https://developer.godaddy.com (keep scopes minimal, e.g. domains.domain:read)
GODADDY_PAT=

# ---- Firebase ----
FIREBASE_PROJECT_ID=
# Option A (local dev): leave credentials blank and run the Firebase emulators, set the hosts below.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Option B (real project): paste the service-account JSON as ONE line (or base64-encode it).
FIREBASE_SERVICE_ACCOUNT_JSON=
