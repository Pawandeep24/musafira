# Copy to .env (gitignored) and fill in. Never commit real values.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Comma-separated list of allowed browser origins (frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- GoDaddy ----
# Selects which key/secret pair below is used: "ote" (sandbox) or "production".
GODADDY_ENV=ote
GODADDY_OTE_API_KEY=
GODADDY_OTE_API_SECRET=
GODADDY_PRODUCTION_API_KEY=
GODADDY_PRODUCTION_API_SECRET=

# ---- Firebase ----
FIREBASE_PROJECT_ID=
# Public identifier (not a secret). Only the smoke test needs it, to sign in a throwaway user.
FIREBASE_WEB_API_KEY=
# Option A (local dev): leave credentials blank and run the Firebase emulators, set the hosts below.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Option B (real project): paste the service-account JSON as ONE line (or base64-encode it).
FIREBASE_SERVICE_ACCOUNT_JSON=
